# ── API OpenPPM ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MySQL
DATABASE_URL="mysql://root:root@localhost:3307/openppm"

# JWT — secret d'au moins 32 caractères, à générer : openssl rand -hex 32
JWT_SECRET="change-me-change-me-change-me-change-me"
JWT_ACCESS_TTL="900s"
REFRESH_TTL_DAYS=30

# Frontend (liens emails, CORS)
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Répertoire de stockage des documents (GED)
FILES_DIR="./storage"

# SMTP (optionnel en dev — les emails sont journalisés si absent)
# SMTP_URL="smtp://localhost:1025"
SMTP_FROM="OpenPPM <no-reply@openppm.local>"
