// OpenPPM — schéma Prisma
// Phase 0 : domaine identité / accès / audit.
// Conventions : UUID v7 en PK, snake_case en base via @map/@@map,
// soft delete par deleted_at, organization_id sur toute table métier.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Organisations (tenant) ─────────────────────────────────────────────

model Organization {
  id        String    @id @default(uuid(7)) @db.Char(36)
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(60)
  settings  Json?
  plan      String    @default("community") @db.VarChar(30)
  /// Propriétaire initial de l'organisation (Organization Owner). Peut gérer
  /// l'org, le billing et transférer la propriété. Nullable le temps du backfill.
  ownerUserId String? @map("owner_user_id") @db.Char(36)
  /// Coordonnées société (page Organisation / facturation).
  country    String? @db.VarChar(2)
  address    String? @db.VarChar(255)
  vatNumber  String? @map("vat_number") @db.VarChar(40)
  logoUrl    String? @map("logo_url") @db.VarChar(500)
  /// Autorise la création directe d'un projet (hors conversion d'une demande).
  /// Désactivée, seul un administrateur peut créer un projet directement.
  allowDirectProjectCreation Boolean @default(true) @map("allow_direct_project_creation")
  /// Règle de gouvernance : si activée, seules les demandes dont le budget
  /// dépasse le seuil (100 k€) passent par le comité d'investissement ; en
  /// dessous, la validation Finance suffit à créer le projet. Désactivée, toute
  /// demande passe par le comité (comportement par défaut).
  committeeRuleEnabled Boolean @default(false) @map("committee_rule_enabled")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  ownerUser   User?                    @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  memberships OrganizationMembership[]
  users       User[]
  roles       Role[]
  groups      Group[]
  auditLogs   AuditLog[]
  invitations       Invitation[]
  projects          Project[]
  projectCategories ProjectCategory[]
  projectTemplates  ProjectTemplate[]
  portfolios        Portfolio[]
  workflowDefinitions WorkflowDefinition[]
  demands           Demand[]
  risks             Risk[]
  budgetApprovalTiers BudgetApprovalTier[]
  subscription      Subscription?
  invoices          Invoice[]

  @@map("organizations")
}

// ── Utilisateurs ───────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid(7)) @db.Char(36)
  organizationId   String    @map("organization_id") @db.Char(36)
  email            String    @unique @db.VarChar(190)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  firstName        String    @map("first_name") @db.VarChar(80)
  lastName         String    @map("last_name") @db.VarChar(80)
  locale           String    @default("fr") @db.VarChar(5)
  timezone         String    @default("Europe/Paris") @db.VarChar(50)
  isActive         Boolean   @default(true) @map("is_active")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") @db.VarChar(255)
  /// Hashes SHA-256 des codes de récupération 2FA restants
  mfaRecoveryCodes Json?     @map("mfa_recovery_codes")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  organization    Organization    @relation(fields: [organizationId], references: [id])
  memberships       OrganizationMembership[]
  ownedOrganizations Organization[]         @relation("OrganizationOwner")
  userRoles       UserRole[]
  groupMembers    GroupMember[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
  auditLogs       AuditLog[]
  sentInvitations Invitation[]    @relation("InvitedBy")
  managedProjects  Project[]         @relation("ProjectManager")
  createdProjects  Project[]         @relation("ProjectCreator")
  projectMembers   ProjectMember[]
  favorites        Favorite[]
  createdTemplates ProjectTemplate[]
  createdTasks     Task[]            @relation("TaskCreator")
  taskAssignments  TaskAssignee[]
  timeEntries      TimeEntry[]
  uploadedDocuments Document[]
  notifications    Notification[]
  comments         Comment[]
  ownedPortfolios  Portfolio[]       @relation("PortfolioOwner")
  budgetRequests   BudgetRequest[]   @relation("BudgetRequester")
  approvalDecisions ApprovalStep[]   @relation("ApprovalDecider")
  budgetLines      BudgetLine[]      @relation("BudgetLineAuthor")
  costEntries      CostEntry[]       @relation("CostEntryAuthor")
  workflowActions  WorkflowTransitionLog[] @relation("WorkflowActor")
  requestedDemands Demand[]          @relation("DemandRequester")
  businessCases    BusinessCase[]    @relation("BusinessCaseAuthor")
  ownedRisks       Risk[]            @relation("RiskOwner")
  createdQuotes    Quote[]           @relation("QuoteCreator")
  reviewedQuotes   Quote[]           @relation("QuoteReviewer")
  approvedQuotes   Quote[]           @relation("QuoteApprover")

  @@index([organizationId])
  @@map("users")
}

// ── RBAC ───────────────────────────────────────────────────────────────

/// Clés des rôles système. Les rôles personnalisés (phase Enterprise)
/// auront key = null et is_system = false.
enum RoleKey {
  admin
  manager
  project_manager
  pmo
  finance
  employee
  observer
  guest
  /// Analyste métier : prépare le Business Case (Demand Management)
  business_analyst
  /// Direction / Comité d'investissement : validation finale des demandes
  executive
}

model Role {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(80)
  key            RoleKey? @unique
  isSystem       Boolean  @default(false) @map("is_system")
  /// Rôle désactivé : conservé mais non attribuable / ignoré dans les droits.
  active         Boolean  @default(true)
  description    String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]
  invitations     Invitation[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id         String  @id @default(uuid(7)) @db.Char(36)
  action     String  @db.VarChar(60)
  subject    String  @db.VarChar(60)
  conditions Json?

  rolePermissions RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Char(36)
  permissionId String @map("permission_id") @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Statut d'un membre au sein d'une organisation (SaaS multi-tenant).
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

/// Rattachement N:N d'un compte utilisateur à une organisation (tenant).
/// Un même compte peut appartenir à plusieurs organisations avec des rôles
/// différents dans chacune. Les rôles « effectifs » se lisent par membership.
model OrganizationMembership {
  id             String           @id @default(uuid(7)) @db.Char(36)
  userId         String           @map("user_id") @db.Char(36)
  organizationId String           @map("organization_id") @db.Char(36)
  status         MembershipStatus @default(ACTIVE)
  isOwner        Boolean          @default(false) @map("is_owner")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id])
  roles        MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

/// Rôles attribués à un membre dans le contexte d'une organisation.
model MembershipRole {
  membershipId String @map("membership_id") @db.Char(36)
  roleId       String @map("role_id") @db.Char(36)

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

model Group {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  members      GroupMember[]

  @@unique([organizationId, name])
  @@map("groups")
}

model GroupMember {
  groupId String @map("group_id") @db.Char(36)
  userId  String @map("user_id") @db.Char(36)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

/// Invitation d'un collaborateur dans une organisation, avec rôle
/// pré-assigné. Jeton envoyé par email, stocké haché, usage unique.
model Invitation {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  email          String    @db.VarChar(190)
  roleId         String    @map("role_id") @db.Char(36)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  invitedById    String    @map("invited_by_id") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ── Jetons ─────────────────────────────────────────────────────────────

/// Refresh tokens rotatifs. family_id identifie la « famille » issue d'un
/// même login : la réutilisation d'un token révoqué entraîne la révocation
/// de toute la famille (détection de vol).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  /// Organisation courante au moment de l'émission (préservée au refresh).
  organizationId String? @map("organization_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Char(36)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?   @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// ── Projets ────────────────────────────────────────────────────────────

/// Cycle de vie Phase 1 (workflow figé) : draft → active ⇄ on_hold,
/// active → completed (réouvrable), tout état ⇄ archived.
enum ProjectStatus {
  draft
  active
  on_hold
  completed
  archived
}

enum ProjectHealth {
  green
  amber
  red
}

enum ProjectRole {
  manager
  member
  observer
}

model Project {
  id             String        @id @default(uuid(7)) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  code           String        @db.VarChar(20)
  name           String        @db.VarChar(140)
  description    String?       @db.Text
  status         ProjectStatus @default(draft)
  health         ProjectHealth @default(green)
  /// Priorité 1 (haute) à 5 (basse)
  priority       Int           @default(3)
  startDate      DateTime?     @map("start_date") @db.Date
  endDate        DateTime?     @map("end_date") @db.Date
  /// Budget approuvé via le workflow de gouvernance (non saisi librement).
  budget         Decimal?      @db.Decimal(14, 2)
  /// Taux horaire (€) servant à valoriser les temps saisis en coût de main-d'œuvre.
  laborRate      Decimal?      @map("labor_rate") @db.Decimal(10, 2)
  categoryId     String?       @map("category_id") @db.Char(36)
  portfolioId    String?       @map("portfolio_id") @db.Char(36)
  managerId      String?       @map("manager_id") @db.Char(36)
  /// Demande d'origine, lorsque le projet est issu d'une conversion (traçabilité).
  demandId       String?       @unique @map("demand_id") @db.Char(36)
  createdById    String        @map("created_by_id") @db.Char(36)
  archivedAt     DateTime?     @map("archived_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     ProjectCategory? @relation(fields: [categoryId], references: [id])
  portfolio    Portfolio?       @relation(fields: [portfolioId], references: [id])
  manager      User?            @relation("ProjectManager", fields: [managerId], references: [id])
  createdBy    User             @relation("ProjectCreator", fields: [createdById], references: [id])
  originDemand Demand?          @relation("DemandProject", fields: [demandId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
  board          Board?
  documents      Document[]
  budgetRequests BudgetRequest[]
  budgetLines    BudgetLine[]
  costEntries    CostEntry[]
  quotes         Quote[]
  risks          Risk[]

  @@unique([organizationId, code])
  @@index([organizationId, portfolioId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Char(36)
  userId    String      @map("user_id") @db.Char(36)
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

model ProjectCategory {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(60)
  /// Couleur hexadécimale (#rrggbb)
  color          String   @default("#0071e3") @db.VarChar(7)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id])
  projects     Project[]
  templates    ProjectTemplate[]

  @@unique([organizationId, name])
  @@map("project_categories")
}

/// Modèle de projet : valeurs par défaut appliquées à la création.
/// duration_days calcule la date de fin à partir de la date de début.
model ProjectTemplate {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  name           String   @db.VarChar(140)
  description    String?  @db.Text
  priority       Int      @default(3)
  budget         Decimal? @db.Decimal(14, 2)
  durationDays   Int?     @map("duration_days")
  categoryId     String?  @map("category_id") @db.Char(36)
  createdById    String   @map("created_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  category     ProjectCategory? @relation(fields: [categoryId], references: [id])
  createdBy    User             @relation(fields: [createdById], references: [id])

  @@unique([organizationId, name])
  @@map("project_templates")
}

// ── Tâches ─────────────────────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

model Task {
  id             String     @id @default(uuid(7)) @db.Char(36)
  organizationId String     @map("organization_id") @db.Char(36)
  projectId      String     @map("project_id") @db.Char(36)
  parentId       String?    @map("parent_id") @db.Char(36)
  title          String     @db.VarChar(200)
  description    String?    @db.Text
  status         TaskStatus @default(todo)
  /// Priorité 1 (haute) à 5 (basse)
  priority       Int        @default(3)
  startDate      DateTime?  @map("start_date") @db.Date
  dueDate        DateTime?  @map("due_date") @db.Date
  estimateHours  Decimal?   @map("estimate_hours") @db.Decimal(7, 2)
  position       Int        @default(0)
  boardColumnId  String?    @map("board_column_id") @db.Char(36)
  /// Ordre de la carte dans sa colonne Kanban
  boardRank      Int        @default(0) @map("board_rank")
  createdById    String     @map("created_by_id") @db.Char(36)
  completedAt    DateTime?  @map("completed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  project      Project          @relation(fields: [projectId], references: [id])
  parent       Task?            @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Task[]           @relation("Subtasks")
  createdBy    User             @relation("TaskCreator", fields: [createdById], references: [id])
  assignees    TaskAssignee[]
  checklist    ChecklistItem[]
  /// Dépendances où cette tâche est le successeur (ses prérequis)
  predecessors TaskDependency[] @relation("Successor")
  /// Dépendances où cette tâche est le prédécesseur
  successors   TaskDependency[] @relation("Predecessor")
  timeEntries  TimeEntry[]
  boardColumn  BoardColumn?     @relation(fields: [boardColumnId], references: [id])

  @@index([projectId, status])
  @@index([projectId, parentId])
  @@index([organizationId])
  @@map("tasks")
}

model TaskAssignee {
  taskId    String   @map("task_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

model ChecklistItem {
  id        String   @id @default(uuid(7)) @db.Char(36)
  taskId    String   @map("task_id") @db.Char(36)
  label     String   @db.VarChar(300)
  isDone    Boolean  @default(false) @map("is_done")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklist_items")
}

/// Dépendance fin → début (FS) : le successeur ne démarre qu'après le
/// prédécesseur. Types SS/FF/SF au lot Gantt (M4).
model TaskDependency {
  id            String   @id @default(uuid(7)) @db.Char(36)
  predecessorId String   @map("predecessor_id") @db.Char(36)
  successorId   String   @map("successor_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")

  predecessor Task @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@map("task_dependencies")
}

model TimeEntry {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  taskId         String   @map("task_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  spentOn        DateTime @map("spent_on") @db.Date
  hours          Decimal  @db.Decimal(6, 2)
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([organizationId, userId, spentOn])
  @@map("time_entries")
}

// ── Documents (GED v1) ─────────────────────────────────────────────────

/// Pièce jointe rattachée soit à un projet, soit à une demande (parent exclusif,
/// invariant vérifié en service). Les pièces d'une demande sont reprises par le
/// projet lors de la conversion.
model Document {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  projectId      String?  @map("project_id") @db.Char(36)
  demandId       String?  @map("demand_id") @db.Char(36)
  name           String   @db.VarChar(255)
  storagePath    String   @map("storage_path") @db.VarChar(500)
  mimeType       String   @map("mime_type") @db.VarChar(120)
  /// Taille en octets (limite d'upload 25 Mo)
  size           Int
  uploadedById   String   @map("uploaded_by_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")

  project    Project? @relation(fields: [projectId], references: [id])
  demand     Demand?  @relation(fields: [demandId], references: [id])
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([demandId])
  @@map("documents")
}

// ── Kanban ─────────────────────────────────────────────────────────────

/// Board Kanban — un par projet en Phase 1, créé paresseusement avec des
/// colonnes par défaut mappées aux statuts des tâches.
model Board {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  projectId      String   @unique @map("project_id") @db.Char(36)
  name           String   @default("Board") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id])
  columns BoardColumn[]

  @@map("boards")
}

model BoardColumn {
  id       String      @id @default(uuid(7)) @db.Char(36)
  boardId  String      @map("board_id") @db.Char(36)
  name     String      @db.VarChar(60)
  position Int         @default(0)
  /// Limite WIP indicative (surbrillance si dépassée, non bloquante)
  wipLimit Int?        @map("wip_limit")
  /// Statut appliqué aux tâches déposées dans cette colonne
  mapsToStatus TaskStatus? @map("maps_to_status")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
  @@map("board_columns")
}

/// Favoris par utilisateur, polymorphe (entity_type + entity_id).
model Favorite {
  userId     String   @map("user_id") @db.Char(36)
  entityType String   @map("entity_type") @db.VarChar(60)
  entityId   String   @map("entity_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, entityType, entityId])
  @@map("favorites")
}

// ── Portefeuilles ──────────────────────────────────────────────────────

enum PortfolioStatus {
  active
  archived
}

/// Portefeuille : regroupe des projets sous une enveloppe budgétaire.
/// Les budgets projets découlent de la gouvernance, pas d'une saisie libre.
model Portfolio {
  id              String          @id @default(uuid(7)) @db.Char(36)
  organizationId  String          @map("organization_id") @db.Char(36)
  name            String          @db.VarChar(140)
  description     String?         @db.Text
  ownerId         String?         @map("owner_id") @db.Char(36)
  /// Enveloppe budgétaire totale allouée au portefeuille
  budgetEnvelope  Decimal?        @map("budget_envelope") @db.Decimal(16, 2)
  status          PortfolioStatus @default(active)
  createdById     String          @map("created_by_id") @db.Char(36)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  owner        User?        @relation("PortfolioOwner", fields: [ownerId], references: [id])
  projects     Project[]
  demands      Demand[]

  @@index([organizationId, deletedAt])
  @@map("portfolios")
}

// ── Gouvernance budgétaire ─────────────────────────────────────────────

enum BudgetRequestStatus {
  draft
  pending
  approved
  rejected
}

enum ApprovalDecision {
  pending
  approved
  rejected
}

/// Demande de budget d'un projet, validée étape par étape.
/// Un budget approuvé fixe le budget du projet et l'active.
model BudgetRequest {
  id             String              @id @default(uuid(7)) @db.Char(36)
  organizationId String              @map("organization_id") @db.Char(36)
  projectId      String              @map("project_id") @db.Char(36)
  amount         Decimal             @db.Decimal(14, 2)
  capexAmount    Decimal             @default(0) @map("capex_amount") @db.Decimal(14, 2)
  opexAmount     Decimal             @default(0) @map("opex_amount") @db.Decimal(14, 2)
  justification  String?             @db.Text
  status         BudgetRequestStatus @default(pending)
  /// Index de l'étape en attente de décision (0-based)
  currentStep    Int                 @default(0) @map("current_step")
  requestedById  String              @map("requested_by_id") @db.Char(36)
  decidedAt      DateTime?           @map("decided_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User           @relation("BudgetRequester", fields: [requestedById], references: [id])
  steps       ApprovalStep[]

  @@index([projectId, status])
  @@map("budget_requests")
}

model ApprovalStep {
  id              String           @id @default(uuid(7)) @db.Char(36)
  budgetRequestId String           @map("budget_request_id") @db.Char(36)
  stepOrder       Int              @map("step_order")
  /// Rôle habilité à décider de cette étape
  approverRole    RoleKey          @map("approver_role")
  status          ApprovalDecision @default(pending)
  decidedById     String?          @map("decided_by_id") @db.Char(36)
  comment         String?          @db.VarChar(500)
  decidedAt       DateTime?        @map("decided_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  budgetRequest BudgetRequest @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)
  decidedBy     User?         @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([budgetRequestId, stepOrder])
  @@map("approval_steps")
}

/// Palier de validation budgétaire configurable : un montant dans [minAmount,
/// maxAmount[ impose la chaîne d'approbateurs `approverRoles` (ordonnée).
/// En l'absence de paliers pour une org, une chaîne par défaut s'applique.
model BudgetApprovalTier {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  /// Borne basse incluse.
  minAmount      Decimal  @map("min_amount") @db.Decimal(14, 2)
  /// Borne haute exclue (null = pas de plafond).
  maxAmount      Decimal? @map("max_amount") @db.Decimal(14, 2)
  /// Rôles approbateurs ordonnés (JSON de RoleKey), ex. ["finance","executive"].
  approverRoles  Json     @map("approver_roles")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, position])
  @@map("budget_approval_tiers")
}

// ── Finances détaillées ────────────────────────────────────────────────

enum BudgetCategory {
  capex
  opex
}

/// Ligne de budget prévisionnel d'un projet (répartition CAPEX/OPEX du
/// budget approuvé). Sert de référentiel de rattachement des coûts réels.
model BudgetLine {
  id             String         @id @default(uuid(7)) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  projectId      String         @map("project_id") @db.Char(36)
  category       BudgetCategory
  label          String         @db.VarChar(160)
  plannedAmount  Decimal        @map("planned_amount") @db.Decimal(14, 2)
  createdById    String         @map("created_by_id") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User        @relation("BudgetLineAuthor", fields: [createdById], references: [id])
  costs     CostEntry[]

  @@index([projectId, category])
  @@map("budget_lines")
}

/// Coût réel enregistré sur un projet (dépense engagée ou facturée).
/// Rattachable à une ligne de budget. Le coût de main-d'œuvre est calculé
/// à part depuis les temps saisis (taux horaire du projet) et non stocké ici.
model CostEntry {
  id             String         @id @default(uuid(7)) @db.Char(36)
  organizationId String         @map("organization_id") @db.Char(36)
  projectId      String         @map("project_id") @db.Char(36)
  budgetLineId   String?        @map("budget_line_id") @db.Char(36)
  category       BudgetCategory
  label          String         @db.VarChar(160)
  amount         Decimal        @db.Decimal(14, 2)
  incurredOn     DateTime       @map("incurred_on") @db.Date
  createdById    String         @map("created_by_id") @db.Char(36)
  createdAt      DateTime       @default(now()) @map("created_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("CostEntryAuthor", fields: [createdById], references: [id])

  @@index([projectId, incurredOn])
  @@map("cost_entries")
}

// ── Devis (quotations) ─────────────────────────────────────────────────

/// Cycle de validation à deux niveaux :
/// draft → submitted → reviewed (niveau 1) → approved (niveau 2) ; rejected à tout stade.
enum QuoteStatus {
  draft
  submitted
  reviewed
  approved
  rejected
}

/// Devis rattaché à un projet. Totaux HT/TVA/TTC calculés depuis les lignes.
model Quote {
  id              String      @id @default(uuid(7)) @db.Char(36)
  organizationId  String      @map("organization_id") @db.Char(36)
  projectId       String      @map("project_id") @db.Char(36)
  reference       String      @db.VarChar(30)
  title           String      @db.VarChar(160)
  customerName    String?     @map("customer_name") @db.VarChar(160)
  status          QuoteStatus @default(draft)
  /// Numéro de révision (une nouvelle version repart d'un devis clôturé)
  revision        Int         @default(1)
  /// Taux de TVA appliqué (%)
  vatRate         Decimal     @default(20) @map("vat_rate") @db.Decimal(5, 2)
  validUntil      DateTime?   @map("valid_until") @db.Date
  notes           String?     @db.Text
  createdById     String      @map("created_by_id") @db.Char(36)
  submittedAt     DateTime?   @map("submitted_at")
  reviewedById    String?     @map("reviewed_by_id") @db.Char(36)
  reviewedAt      DateTime?   @map("reviewed_at")
  approvedById    String?     @map("approved_by_id") @db.Char(36)
  approvedAt      DateTime?   @map("approved_at")
  decisionComment String?     @map("decision_comment") @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("QuoteCreator", fields: [createdById], references: [id])
  reviewedBy User?       @relation("QuoteReviewer", fields: [reviewedById], references: [id])
  approvedBy User?       @relation("QuoteApprover", fields: [approvedById], references: [id])
  lines      QuoteLine[]

  @@unique([organizationId, reference])
  @@index([projectId, status])
  @@map("quotes")
}

/// Ligne de devis. Montant HT = quantité × prix unitaire × (1 − remise%).
model QuoteLine {
  id           String   @id @default(uuid(7)) @db.Char(36)
  quoteId      String   @map("quote_id") @db.Char(36)
  label        String   @db.VarChar(200)
  quantity     Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountRate Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@map("quote_lines")
}

// ── Notifications & commentaires ───────────────────────────────────────

/// Notification in-app d'un utilisateur. `payload` porte les données de
/// rendu (type, libellé, cibles) résolues côté client via i18n.
model Notification {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  type           String    @db.VarChar(60)
  payload        Json
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Commentaire polymorphe (entity_type + entity_id). Phase 1 : tâches.
/// `mentions` : liste des user_id mentionnés (résolus au moment du post).
model Comment {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  entityType     String   @map("entity_type") @db.VarChar(60)
  entityId       String   @map("entity_id") @db.Char(36)
  authorId       String   @map("author_id") @db.Char(36)
  body           String   @db.Text
  mentions       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@map("comments")
}

// ── Audit ──────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String?  @map("organization_id") @db.Char(36)
  userId         String?  @map("user_id") @db.Char(36)
  action         String   @db.VarChar(80)
  entityType     String   @map("entity_type") @db.VarChar(60)
  entityId       String?  @map("entity_id") @db.Char(36)
  before         Json?
  after          Json?
  ip             String?  @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── Moteur de workflow (générique et réutilisable) ─────────────────────
//
// Les états et les transitions vivent en base : aucun statut n'est codé en
// dur. Le moteur ignore tout du métier — il pilote n'importe quel type
// d'entité via `entityType` (demand, project, risk, …).

enum WorkflowStateKind {
  initial
  intermediate
  /// État terminal favorable (ex. « approuvée »)
  final_ok
  /// État terminal défavorable (ex. « rejetée »)
  final_ko
}

/// Définition d'un workflow pour un type d'entité donné.
model WorkflowDefinition {
  id             String   @id @default(uuid(7)) @db.Char(36)
  organizationId String   @map("organization_id") @db.Char(36)
  /// Identifiant stable de la définition (ex. « demand-default »)
  key            String   @db.VarChar(60)
  /// Type d'entité piloté (ex. « demand »)
  entityType     String   @map("entity_type") @db.VarChar(60)
  name           String   @db.VarChar(140)
  /// Définition retenue par défaut pour ce type d'entité
  isDefault      Boolean  @default(false) @map("is_default")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id])
  states       WorkflowState[]
  transitions  WorkflowTransition[]
  instances    WorkflowInstance[]

  @@unique([organizationId, key])
  @@index([organizationId, entityType, active])
  @@map("workflow_definitions")
}

model WorkflowState {
  id           String            @id @default(uuid(7)) @db.Char(36)
  definitionId String            @map("definition_id") @db.Char(36)
  key          String            @db.VarChar(60)
  label        String            @db.VarChar(140)
  kind         WorkflowStateKind @default(intermediate)
  position     Int               @default(0)

  definition      WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  transitionsFrom WorkflowTransition[] @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[] @relation("TransitionTo")
  instances       WorkflowInstance[]

  @@unique([definitionId, key])
  @@index([definitionId, position])
  @@map("workflow_states")
}

model WorkflowTransition {
  id              String  @id @default(uuid(7)) @db.Char(36)
  definitionId    String  @map("definition_id") @db.Char(36)
  fromStateId     String  @map("from_state_id") @db.Char(36)
  toStateId       String  @map("to_state_id") @db.Char(36)
  key             String  @db.VarChar(60)
  label           String  @db.VarChar(140)
  /// Clés de rôles autorisés (RoleKey). Absent ou vide = aucun rôle exigé.
  allowedRoles    Json?   @map("allowed_roles")
  requiresComment Boolean @default(false) @map("requires_comment")
  /// Automatisations à déclencher après franchissement, interprétées par le
  /// module métier appelant (ex. { "createProject": true }).
  autoAction      Json?   @map("auto_action")
  position        Int     @default(0)

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fromState  WorkflowState      @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState    WorkflowState      @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Cascade)

  @@unique([definitionId, key])
  @@index([definitionId, fromStateId, position])
  @@map("workflow_transitions")
}

/// Position courante d'une entité dans son workflow (une seule par entité).
model WorkflowInstance {
  id             String    @id @default(uuid(7)) @db.Char(36)
  organizationId String    @map("organization_id") @db.Char(36)
  definitionId   String    @map("definition_id") @db.Char(36)
  entityType     String    @map("entity_type") @db.VarChar(60)
  entityId       String    @map("entity_id") @db.Char(36)
  currentStateId String    @map("current_state_id") @db.Char(36)
  startedAt      DateTime  @default(now()) @map("started_at")
  closedAt       DateTime? @map("closed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  definition   WorkflowDefinition      @relation(fields: [definitionId], references: [id])
  currentState WorkflowState           @relation(fields: [currentStateId], references: [id])
  logs         WorkflowTransitionLog[]

  @@unique([entityType, entityId])
  @@index([organizationId, entityType])
  @@map("workflow_instances")
}

/// Journal immuable des franchissements. Les états sont stockés par leur clé
/// (et non par référence) afin que l'historique survive à une reconfiguration.
model WorkflowTransitionLog {
  id            String   @id @default(uuid(7)) @db.Char(36)
  instanceId    String   @map("instance_id") @db.Char(36)
  transitionKey String?  @map("transition_key") @db.VarChar(60)
  fromStateKey  String?  @map("from_state_key") @db.VarChar(60)
  toStateKey    String   @map("to_state_key") @db.VarChar(60)
  actorId       String?  @map("actor_id") @db.Char(36)
  comment       String?  @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor    User?            @relation("WorkflowActor", fields: [actorId], references: [id])

  @@index([instanceId, createdAt])
  @@map("workflow_transition_logs")
}

// ── Demand Management ──────────────────────────────────────────────────
//
// Une demande représente une idée ou un besoin métier avant qu'il ne devienne
// un projet. Son avancement n'est pas porté par une colonne de statut : il est
// piloté par le moteur de workflow (WorkflowInstance sur entityType « demand »).

enum DemandUrgency {
  low
  medium
  high
  critical
}

model Demand {
  id             String        @id @default(uuid(7)) @db.Char(36)
  organizationId String        @map("organization_id") @db.Char(36)
  /// Numéro unique attribué automatiquement (DEMD00001), non modifiable
  reference      String        @db.VarChar(30)
  title          String        @db.VarChar(160)
  description    String?       @db.Text
  objectives     String?       @db.Text
  justification  String?       @db.Text
  requesterId    String        @map("requester_id") @db.Char(36)
  department     String?       @db.VarChar(120)
  /// Priorité 1 (haute) à 5 (basse), même échelle que les projets
  priority       Int           @default(3)
  urgency        DemandUrgency @default(medium)
  estimatedBudget       Decimal? @map("estimated_budget") @db.Decimal(14, 2)
  estimatedDurationDays Int?     @map("estimated_duration_days")
  /// Portefeuille visé (facultatif à la création, affiné lors de la qualification)
  targetPortfolioId String?  @map("target_portfolio_id") @db.Char(36)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization  @relation(fields: [organizationId], references: [id])
  requester       User          @relation("DemandRequester", fields: [requesterId], references: [id])
  targetPortfolio Portfolio?    @relation(fields: [targetPortfolioId], references: [id])
  tags            DemandTag[]
  businessCase    BusinessCase?
  /// Projet issu de la conversion de cette demande (traçabilité, 1-1).
  project         Project?      @relation("DemandProject")
  documents       Document[]

  @@unique([organizationId, reference])
  @@index([organizationId, deletedAt])
  @@index([organizationId, targetPortfolioId])
  @@map("demands")
}

model DemandTag {
  id       String @id @default(uuid(7)) @db.Char(36)
  demandId String @map("demand_id") @db.Char(36)
  label    String @db.VarChar(40)

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@unique([demandId, label])
  @@index([demandId])
  @@map("demand_tags")
}

/// Échelle qualitative commune (probabilité / impact des risques)
enum RiskLevel {
  low
  medium
  high
}

/// Dossier de justification (Business Case) rattaché à une demande.
/// Un seul par demande ; alimenté par le PMO / Business Analyst à l'étape dédiée.
model BusinessCase {
  id               String    @id @default(uuid(7)) @db.Char(36)
  demandId         String    @unique @map("demand_id") @db.Char(36)
  /// Retour sur investissement attendu (analyse qualitative et/ou chiffrée)
  roi              String?   @db.Text
  costs            String?   @db.Text
  benefits         String?   @db.Text
  assumptions      String?   @db.Text
  resources        String?   @db.Text
  dependencies     String?   @db.Text
  plannedStartDate DateTime? @map("planned_start_date") @db.Date
  plannedEndDate   DateTime? @map("planned_end_date") @db.Date
  createdById      String    @map("created_by_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  demand    Demand             @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdBy User               @relation("BusinessCaseAuthor", fields: [createdById], references: [id])
  risks     BusinessCaseRisk[]

  @@map("business_cases")
}

/// Risque identifié dans le Business Case. Repris dans le registre projet à la conversion.
model BusinessCaseRisk {
  id             String    @id @default(uuid(7)) @db.Char(36)
  businessCaseId String    @map("business_case_id") @db.Char(36)
  label          String    @db.VarChar(200)
  probability    RiskLevel @default(medium)
  impact         RiskLevel @default(medium)
  mitigation     String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")

  businessCase BusinessCase @relation(fields: [businessCaseId], references: [id], onDelete: Cascade)

  @@index([businessCaseId])
  @@map("business_case_risks")
}

enum RiskStatus {
  open
  mitigated
  closed
}

/// Registre des risques d'un projet. Un risque repris d'un Business Case lors de
/// la conversion garde le lien vers sa source (sourceBusinessCaseRiskId).
model Risk {
  id             String     @id @default(uuid(7)) @db.Char(36)
  organizationId String     @map("organization_id") @db.Char(36)
  projectId      String     @map("project_id") @db.Char(36)
  label          String     @db.VarChar(200)
  description    String?    @db.Text
  probability    RiskLevel  @default(medium)
  impact         RiskLevel  @default(medium)
  /// Sévérité dérivée (probabilité × impact), figée à l'enregistrement.
  severity       RiskLevel  @default(medium)
  mitigation     String?    @db.Text
  ownerId        String?    @map("owner_id") @db.Char(36)
  status         RiskStatus @default(open)
  /// Risque source dans le Business Case, si repris lors d'une conversion.
  sourceBusinessCaseRiskId String? @map("source_business_case_risk_id") @db.Char(36)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?        @relation("RiskOwner", fields: [ownerId], references: [id])

  @@index([organizationId, projectId])
  @@map("risks")
}

// ── SaaS : abonnements & facturation (Stripe) ───────────────────────────

/// Cycle de vie d'un abonnement (aligné sur Stripe + états métier).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELED
  ENTERPRISE
}

enum BillingInterval {
  month
  year
}

/// Plan commercial — **donnée plateforme** (non modifiable par un client).
/// Les Price IDs Stripe viennent de la configuration, jamais du front.
model SubscriptionPlan {
  id                 String          @id @default(uuid(7)) @db.Char(36)
  key                String          @unique @db.VarChar(30) // STANDARD | ENTERPRISE
  name               String          @db.VarChar(80)
  /// Montant par siège et par mois, en centimes (ex. 2000 = 20,00 €).
  unitAmount         Int             @default(0) @map("unit_amount")
  currency           String          @default("eur") @db.VarChar(3)
  interval           BillingInterval @default(month)
  /// Références des tarifs Stripe (résolues via l'ENV, ici pour traçabilité).
  stripePriceMonthly String?         @map("stripe_price_monthly") @db.VarChar(120)
  stripePriceYearly  String?         @map("stripe_price_yearly") @db.VarChar(120)
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("subscription_plans")
}

/// Abonnement d'une organisation (le tenant est le client facturé, pas l'user).
model Subscription {
  id                   String             @id @default(uuid(7)) @db.Char(36)
  organizationId       String             @unique @map("organization_id") @db.Char(36)
  planKey              String             @default("STANDARD") @map("plan_key") @db.VarChar(30)
  status               SubscriptionStatus @default(TRIALING)
  /// Nombre de sièges facturés (déterminé côté backend).
  quantity             Int                @default(1)
  unitAmount           Int                @default(2000) @map("unit_amount")
  currency             String             @default("eur") @db.VarChar(3)
  interval             BillingInterval    @default(month)
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(120)
  stripeSubscriptionId String?            @map("stripe_subscription_id") @db.VarChar(120)
  trialStart           DateTime?          @map("trial_start")
  trialEnd             DateTime?          @map("trial_end")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

/// Journal des événements Stripe reçus — **idempotence** (un event = une fois).
model BillingEvent {
  id            String    @id @default(uuid(7)) @db.Char(36)
  stripeEventId String    @unique @map("stripe_event_id") @db.VarChar(120)
  type          String    @db.VarChar(80)
  payload       Json
  processedAt   DateTime? @map("processed_at")
  result        String?   @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([type])
  @@map("billing_events")
}

/// Facture d'une organisation (miroir des factures Stripe).
model Invoice {
  id               String   @id @default(uuid(7)) @db.Char(36)
  organizationId   String   @map("organization_id") @db.Char(36)
  stripeInvoiceId  String?  @unique @map("stripe_invoice_id") @db.VarChar(120)
  number           String?  @db.VarChar(60)
  amountDue        Int      @default(0) @map("amount_due")
  currency         String   @default("eur") @db.VarChar(3)
  status           String   @default("draft") @db.VarChar(30)
  periodStart      DateTime? @map("period_start")
  periodEnd        DateTime? @map("period_end")
  hostedInvoiceUrl String?  @map("hosted_invoice_url") @db.VarChar(500)
  pdfUrl           String?  @map("pdf_url") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("invoices")
}
