# ── OpenPPM — variables Docker Compose ────────────────────────────────
# Copier vers .env puis ajuster.

# MySQL (mode 1)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=openppm

# Secrets API — générer : openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=900s
REFRESH_TTL_DAYS=30

# URLs publiques
APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# Ports exposés
WEB_PORT=3000
API_PORT=4000
MAILPIT_UI_PORT=8025

# Email
SMTP_FROM="OpenPPM <no-reply@openppm.local>"

# Modes 2/3 uniquement : MySQL externe
# DATABASE_URL=mysql://user:pass@db-host:3306/openppm
# SMTP_URL=smtp://smtp-host:587
